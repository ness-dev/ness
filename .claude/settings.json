{
  "permissions": {
    "allow": [
      "Bash(npm install --legacy-peer-deps)",
      "Bash(npm install --legacy-peer-deps:*)",
      "Bash(npx electron-vite build)",
      "Bash(npx electron-vite build:*)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "loch hook prompt 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "loch hook stop 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "loch hook end 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
